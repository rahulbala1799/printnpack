{
  "name": "printnpack",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "bash ./use-node-18.sh",
    "dev": "node node_modules/next/dist/bin/next dev",
    "clean": "bash ./use-node-18.sh --clean",
    "clean:full": "bash ./use-node-18.sh --clean --full && npm install",
    "build": "node migrations/migrate.js && node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "next lint",
    "sync-plain-products": "node scripts/sync-plain-products.js",
    "backfill-plain-case-units": "node scripts/backfill-plain-case-units.js",
    "backfill-plain-case-units:live": "MIGRATE_ENV=live node scripts/backfill-plain-case-units.js",
    "sync-plain-catalog": "python3 scripts/sync-plain-catalog-from-cost-list.py",
    "generate-pricelist-pdf": ".venv-pdf/bin/python scripts/generate-print-pricelist-pdf.py --segment full",
    "generate-pricelist-pdf-restaurants": ".venv-pdf/bin/python scripts/generate-print-pricelist-pdf.py --segment restaurants",
    "import-cost-prices": "python3 scripts/export-cost-from-price-adj.py 2>/dev/null | node scripts/import-cost-to-db.js",
    "migrate": "node migrations/migrate.js --env=local",
    "migrate:live": "node migrations/migrate.js --env=live",
    "seed-pricing-rules": "node scripts/seed-pricing-rules.js",
    "seed-pricing-rules:live": "SEED_ENV=live node scripts/seed-pricing-rules.js",
    "merge-env-after-pull": "node scripts/merge-env-after-pull.js",
    "env:pull:live": "vercel env pull .env.live --yes --environment=production && node scripts/merge-env-after-pull.js",
    "env:pull:local": "vercel env pull .env.local --yes --environment=development && node scripts/merge-env-after-pull.js",
    "postinstall": "next telemetry disable"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^3.0.133",
    "@ai-sdk/google": "^1.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.1",
    "@types/pg": "^8.15.5",
    "ai": "^5.0.204",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.3.1",
    "formik": "^2.4.6",
    "framer-motion": "^11.18.2",
    "jsonwebtoken": "^9.0.3",
    "next": "13.4.19",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.10.1",
    "pdfkit": "^0.16.0",
    "pg": "^8.16.3",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-icons": "^5.5.0",
    "react-intersection-observer": "^9.16.0",
    "styled-jsx": "^5.1.6",
    "yup": "^1.6.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "18.18.0",
    "@types/react": "18.2.21",
    "@types/react-dom": "18.2.7",
    "autoprefixer": "10.4.15",
    "eslint": "8.49.0",
    "eslint-config-next": "13.4.19",
    "postcss": "8.4.29",
    "tailwindcss": "3.3.3",
    "typescript": "5.2.2"
  },
  "optionalDependencies": {
    "@next/swc-linux-x64-gnu": "^13.4.19"
  },
  "engines": {
    "node": ">=18.x"
  }
}
