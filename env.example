# Analytics System Environment Variables
# Copy this file to .env.local and fill in your actual values

# Database Configuration (Neon PostgreSQL)
# Local dev: copy to .env.local
# Live/production: copy to .env.live  →  npm run migrate:live
DATABASE_URL=postgresql://your-neon-connection-string

# Email Configuration (Gmail recommended)
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
ANALYTICS_RECIPIENT_EMAIL=your-email@gmail.com

# Alternative SMTP Configuration (uncomment if not using Gmail)
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_SECURE=false

# Analytics System Settings
NODE_ENV=production
ANALYTICS_ENABLED=true
REPORT_TIMEZONE=Europe/Dublin

# Optional: IP Geolocation API (for better country detection)
# IPAPI_KEY=your-ipapi-key
# IPINFO_TOKEN=your-ipinfo-token

# Optional: Enhanced Privacy Settings
ANONYMIZE_IPS=true
TRACK_DEVICE_INFO=true
TRACK_REFERRERS=true

# AI Invoice Creator — OIDC via `vercel env pull` (VERCEL_OIDC_TOKEN) or static key:
AI_GATEWAY_API_KEY=
INVOICE_AI_MODEL=google/gemini-2.5-flash
